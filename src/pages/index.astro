---
import { url } from '../lib/url';
import '../styles/portfolio.css';

// ─── Manga reading order ────────────────────────────────────────────────────
// Pages are listed here in READING order (first page = Hero). The CSS lays
// the track out with `flex-direction: row-reverse`, so page 1 sits on the
// far RIGHT and you travel LEFT to read on — like a tankōbon.
//
// Inside every page, panels are ALSO in reading order in the DOM. The page
// grid uses `direction: rtl`, so CSS grid auto-placement fills the top-right
// cell first, then moves left, then wraps to the next row. You never have to
// hand-position a panel to get manga order: write them in the order a reader
// should see them and the grid does the rest.
//
// `art` panels are transparent windows onto the three.js scene. Each page has
// exactly ONE art panel (the JS pins that page's mesh to it).
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portfolio</title>
    <meta name="description" content="Arnas — Software Engineer based in U.S.A" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <canvas id="webgl"></canvas>

    <a class="blog-link" href={url('/blog/')}>Blog</a>

    <!-- Page controls, laid out the way a manga reads: NEXT sits on the LEFT
         (that's where the next page comes from), PREVIOUS on the right.
         The folio between them is the printed page number; the ticks under it
         run right→left too, so page 1's tick is the rightmost one. -->
    <nav class="pager" aria-label="Pages">
      <button class="pager__btn pager__btn--next" id="pager-next" type="button" aria-label="Next page">
        <span aria-hidden="true">&larr;</span><span class="pager__kana" aria-hidden="true">次</span>
      </button>
      <div class="folio">
        <p class="folio__count" aria-live="polite">
          <span class="folio__current" id="folio-current">01</span><span class="folio__sep">/</span><span id="folio-total">06</span>
        </p>
        <ol class="folio__ticks" id="folio-ticks" aria-hidden="true"></ol>
      </div>
      <button class="pager__btn pager__btn--prev" id="pager-prev" type="button" aria-label="Previous page">
        <span class="pager__kana" aria-hidden="true">前</span><span aria-hidden="true">&rarr;</span>
      </button>
    </nav>

    <!-- The spacer gives the document real vertical height. Lenis scrolls it;
         the JS converts that vertical progress into horizontal travel. -->
    <div class="scroll-spacer" aria-hidden="true"></div>

    <main class="book">
      <div class="track" id="track">

        <!-- 1 — HERO (cover). Wide splash panel on top, two beats below. -->
        <section class="page page--wide" id="hero" data-page="1" aria-label="Cover">
          <div class="panel panel--art" data-art></div>
          <div class="panel panel--text">
            <h1>Arnas</h1>
          </div>
          <div class="panel panel--text panel--tone">
            <p class="subtitle">Software Engineer based in U.S.A</p>
            <p class="scroll-hint">Scroll to read &larr;</p>
          </div>
          <span class="page-no">1</span>
        </section>

        <!-- 2 — ABOUT. Tall art panel on the right, read first. -->
        <section class="page page--tall" id="about" data-page="2" aria-label="About">
          <div class="panel panel--art" data-art></div>
          <div class="panel panel--text">
            <h2>About</h2>
          </div>
          <div class="panel panel--text panel--tone">
            <p>Builder, Engineer</p>
          </div>
          <span class="page-no">2</span>
        </section>

        <!-- 3 — PROJECT: Operation Floresta -->
        <section class="page page--tall" id="project-floresta" data-page="3" aria-label="Operation Floresta">
          <div class="panel panel--art" data-art></div>
          <div class="panel panel--text">
            <p class="chapter">Project 01</p>
            <h2>Operation Floresta</h2>
          </div>
          <div class="panel panel--text panel--tone">
            <p>AI-guided discovery of Amazonian Dark Earths and earthworks in the Upper Xingu — remote sensing, machine learning and GPT-4.1 reasoning.</p>
            <a class="panel-link" href="https://github.com/Arnaslie/operation-floresta" target="_blank" rel="noopener">Read on GitHub &larr;</a>
          </div>
          <span class="page-no">3</span>
        </section>

        <!-- 4 — PROJECT: Tutor Helper Finder. Mirrored layout (wide splash) to vary rhythm. -->
        <section class="page page--wide" id="project-tutor-helper-finder" data-page="4" aria-label="Tutor Helper Finder">
          <div class="panel panel--art" data-art></div>
          <div class="panel panel--text">
            <p class="chapter">Project 02</p>
            <h2>Tutor Helper Finder</h2>
          </div>
          <div class="panel panel--text panel--tone">
            <p>Course-scoped peer tutoring for college students: pick the course you're stuck in, find tutors who aced that exact course under that professor, and book sessions anchored to your next exam. Next.js 16, Postgres + Drizzle, Better Auth, Stripe Connect.</p>
            <a class="panel-link" href="https://github.com/Arnaslie/quad-tutor" target="_blank" rel="noopener">Read on GitHub &larr;</a>
          </div>
          <span class="page-no">4</span>
        </section>

        <!-- 5 — PROJECT: moto-repo -->
        <section class="page page--tall" id="project-moto-repo" data-page="5" aria-label="moto-repo">
          <div class="panel panel--art" data-art></div>
          <div class="panel panel--text">
            <p class="chapter">Project 03</p>
            <h2>moto-repo</h2>
          </div>
          <div class="panel panel--text panel--tone">
            <p>A social platform for motorcycle riders: a ride feed with waves for likes, a garage of your real bikes with a three.js showroom, a live rider map and direct messages. Next.js, Prisma + Postgres, Tailwind.</p>
            <a class="panel-link" href="https://github.com/Arnaslie/moto-repo" target="_blank" rel="noopener">Read on GitHub &larr;</a>
          </div>
          <span class="page-no">5</span>
        </section>

        <!-- 6 — CONNECT (back cover). -->
        <section class="page page--wide" id="contact" data-page="6" aria-label="Connect">
          <div class="panel panel--art" data-art></div>
          <div class="panel panel--text">
            <h2>Connect</h2>
          </div>
          <div class="panel panel--text panel--tone">
            <a class="panel-link" href="mailto:arnutislie12@gmail.com">arnutislie12@gmail.com</a>
            <p class="end-mark">— 完 —</p>
          </div>
          <span class="page-no">6</span>
        </section>

      </div>
    </main>

    <script>
      import '../scripts/portfolio.js';
    </script>
  </body>
</html>
