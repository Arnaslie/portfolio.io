---
import { url } from '../lib/url';
import '../styles/portfolio.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portfolio</title>
    <meta name="description" content="Arnas — Software Engineer based in U.S.A" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <canvas id="webgl"></canvas>

    <a class="blog-link" href={url('/blog/')}>Blog</a>

    <div class="sections-wrapper">
      <section class="section" id="hero">
        <div class="content">
          <h1>Arnas</h1>
          <p class="subtitle">Software Engineer based in U.S.A</p>
          <p class="scroll-hint">Scroll to explore &darr;</p>
        </div>
      </section>

      <section class="section" id="about">
        <div class="content content--right">
          <h2>About</h2>
          <p>Builder, Engineer</p>
        </div>
      </section>

      <section class="section" id="projects">
        <div class="content">
          <h2>Projects</h2>
          <ul class="project-list">
            <li><a href="https://github.com/Arnaslie/operation-floresta" target="_blank">Operation Floresta</a></li>
            <li><a href="https://github.com/Arnaslie/march-madness-2026" target="_blank">March Madness</a></li>
            <li><a href="https://github.com/Arnaslie/Animal-Checker" target="_blank">Animal Checker</a></li>
          </ul>
        </div>
      </section>

      <section class="section" id="contact">
        <div class="content content--center">
          <h2>Connect</h2>
          <p>arnutislie12@gmail.com</p>
        </div>
      </section>
    </div>

    <script>
      import '../scripts/portfolio.js';
    </script>
  </body>
</html>
